# ============================================================
# RADIANT LUCKY DRAW - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# ============================================================

# ─── Frontend (Vite) ────────────────────────────────────────

# App
VITE_APP_TITLE=Radiant Lucky Draw

# Public URL (used for QR registration link)
# Development: http://localhost:5173
# Production:  https://radiant-lucky-draw-production.up.railway.app
VITE_PUBLIC_URL=http://localhost:5173


# API
# Development: http://localhost:3001 (or /api with the Vite proxy)
# Production:  https://radiant-lucky-draw-production.up.railway.app/api
VITE_API_BASE_URL=https://radiant-lucky-draw-production.up.railway.app/api
VITE_API_TIMEOUT=30000

# Realtime (Socket.IO)
# Development: http://localhost:3001
# Production:  wss://radiant-lucky-draw-production.up.railway.app
VITE_SOCKET_URL=wss://radiant-lucky-draw-production.up.railway.app


# Features
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEBUG=false

# ─── Backend (Express) ──────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/radiant_lucky_draw?schema=public"

# JWT (REQUIRED - no fallbacks; server will refuse to start without these)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d


# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=dev

# ─── Docker Compose ─────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=radiant_lucky_draw
