// ============================================================
// RADIANT LUCKY DRAW - Prisma Schema
// Database: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER
// ============================================================
model User {
  id          String    @id @default(uuid()) @db.Uuid
  username    String    @unique @db.VarChar(50)
  email       String    @unique @db.VarChar(255)
  password    String    @db.VarChar(255)
  role        String    @default("operator") @db.VarChar(20) // admin | operator
  isActive    Boolean   @default(true)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  auditLogs    AuditLog[]
  announcements Announcement[]
  sessions     Session[]

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}


// ============================================================
// SESSION
// ============================================================
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  refreshToken  String    @unique @map("refresh_token") @db.VarChar(500)
  userAgent     String?   @map("user_agent") @db.VarChar(500)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime  @map("expires_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason") @db.VarChar(200)
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("sessions")
}

// ============================================================
// PARTICIPANT
// ============================================================
model Participant {

  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String?  @db.VarChar(255)
  phone        String?  @unique @db.VarChar(20)
  company      String?  @db.VarChar(100)
  queueNumber  String?  @db.VarChar(20)
  status       String   @default("registered") @db.VarChar(20) // registered | called | completed | cancelled
  registeredAt DateTime @default(now()) @map("registered_at")
  calledAt     DateTime? @map("called_at")
  completedAt  DateTime? @map("completed_at")
  photoUrl     String?  @map("photo_url") @db.VarChar(500)
  prizeId      String?  @map("prize_id") @db.Uuid
  claimStatus  String   @default("unclaimed") @map("claim_status") @db.VarChar(20) // unclaimed | claimed
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  queueEntries QueueEntry[]
  draws        DrawParticipant[]
  winners      Winner[]

  @@index([claimStatus])
  @@index([prizeId])


  @@index([status])
  @@index([queueNumber])
  @@index([deletedAt])
  @@map("participants")
}

// ============================================================
// PRIZE
// ============================================================
model Prize {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  value       Float    @default(0)
  currency    String   @default("USD") @db.VarChar(3)
  quantity    Int      @default(1)
  remaining   Int      @default(1)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  sponsor     String?  @db.VarChar(200)
  tier        String   @default("bronze") @db.VarChar(20) // bronze | silver | gold | platinum | diamond
  probability Float    @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  draws  Draw[]
  awards Winner[]


  @@index([tier])
  @@index([isActive])
  @@index([deletedAt])
  @@map("prizes")
}

// ============================================================
// DRAW
// ============================================================
model Draw {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(200)
  prizeId     String    @map("prize_id") @db.Uuid
  prizeName   String    @map("prize_name") @db.VarChar(200)
  status      String    @default("pending") @db.VarChar(20) // pending | countdown | spinning | revealed | completed | cancelled
  winnerId    String?   @map("winner_id") @db.Uuid
  winnerName  String?   @map("winner_name") @db.VarChar(100)
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  prize        Prize             @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  winner       Winner?           @relation("DrawWinner")
  participants DrawParticipant[]
  queueEntries QueueEntry[]

  @@index([status])
  @@index([prizeId])
  @@index([deletedAt])
  @@map("draws")
}

// ============================================================
// DRAW PARTICIPANT (Join Table)
// ============================================================
model DrawParticipant {
  id            String   @id @default(uuid()) @db.Uuid
  drawId        String   @map("draw_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  draw        Draw        @relation(fields: [drawId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([drawId, participantId])
  @@index([drawId])
  @@index([participantId])
  @@map("draw_participants")
}

// ============================================================
// WINNER
// ============================================================
model Winner {
  id            String   @id @default(uuid()) @db.Uuid
  drawId        String   @unique @map("draw_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  prizeId       String   @map("prize_id") @db.Uuid
  prizeTier     String   @map("prize_tier") @db.VarChar(20)
  prizeValue    Float    @map("prize_value")
  claimStatus   String   @default("unclaimed") @map("claim_status") @db.VarChar(20) // unclaimed | claimed
  announcedAt   DateTime @default(now()) @map("announced_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  draw        Draw        @relation("DrawWinner", fields: [drawId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  prize       Prize       @relation(fields: [prizeId], references: [id], onDelete: Restrict)

  @@index([participantId])
  @@index([prizeId])
  @@index([prizeTier])
  @@index([claimStatus])
  @@index([deletedAt])
  @@map("winners")

}

// ============================================================
// QUEUE ENTRY
// ============================================================
model QueueEntry {
  id              String    @id @default(uuid()) @db.Uuid
  participantId   String    @map("participant_id") @db.Uuid
  participantName String    @map("participant_name") @db.VarChar(100)
  queueNumber     String    @map("queue_number") @db.VarChar(20)
  status          String    @default("waiting") @db.VarChar(20) // waiting | called | completed | cancelled
  calledAt        DateTime? @map("called_at")
  completedAt     DateTime? @map("completed_at")
  drawId          String?   @map("draw_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  draw        Draw?       @relation(fields: [drawId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([queueNumber])
  @@index([participantId])
  @@index([drawId])
  @@index([deletedAt])
  @@map("queue_entries")
}

// ============================================================
// SPONSOR
// ============================================================
model Sponsor {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  websiteUrl  String?  @map("website_url") @db.VarChar(500)
  tier        String   @default("standard") @db.VarChar(20) // standard | silver | gold | platinum
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([tier])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("sponsors")
}

// ============================================================
// ANNOUNCEMENT
// ============================================================
model Announcement {
  id        String    @id @default(uuid()) @db.Uuid
  title     String    @db.VarChar(200)
  message   String    @db.Text
  type      String    @default("info") @db.VarChar(20) // info | warning | success | emergency
  priority  Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  expiresAt DateTime? @map("expires_at")
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  user User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([isActive])
  @@index([priority])
  @@index([deletedAt])
  @@map("announcements")
}

// ============================================================
// SETTINGS
// ============================================================
model Settings {
  id                String   @id @default(uuid()) @db.Uuid
  eventName         String   @map("event_name") @db.VarChar(200)
  eventDate         DateTime? @map("event_date")
  maxParticipants   Int      @default(1000) @map("max_participants")
  drawInterval      Int      @default(30) @map("draw_interval")
  celebrationLevel  String   @default("medium") @map("celebration_level") @db.VarChar(20) // low | medium | high | extreme
  theme             String   @default("dark") @db.VarChar(20) // dark | light | luxury
  soundEnabled      Boolean  @default(true) @map("sound_enabled")
  autoAdvance       Boolean  @default(false) @map("auto_advance")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("settings")
}

// ============================================================
// AUDIT LOG
// ============================================================
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50) // create | update | delete | login | logout | draw_start | draw_complete
  entity     String   @db.VarChar(50) // user | participant | prize | draw | queue | settings
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
