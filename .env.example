# ============================================================
# RADIANT LUCKY DRAW - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# ============================================================

# ─── Frontend (Vite) ────────────────────────────────────────

# App
VITE_APP_TITLE=Radiant Lucky Draw

# Public URL (used for QR registration link)
# Development: http://localhost:5173
# Production:  https://radiant-lucky-draw.vercel.app
VITE_PUBLIC_URL=http://localhost:5173


# API — the backend runs as the Supabase Edge Function `api`.
# Production: leave unset → https://radiant-lucky-draw.vercel.app/api (Vercel rewrites /api/* to the function)
# Development: /api (Vite proxies /api/* to the function; see vite.config.ts)
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=30000

# Realtime — Supabase Realtime broadcast (public values; defaults are built in)
VITE_SUPABASE_URL=https://emwmnghbxsoudfxxltna.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_1rcvks3PA63JAOEvfP9uPg_zjTuvcKR

# Features
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEBUG=false

# ─── Backend (Supabase Edge Function `api`) ─────────────────
# Supabase injects SUPABASE_URL, SUPABASE_DB_URL and SUPABASE_SERVICE_ROLE_KEY.
# Everything below is OPTIONAL (Edge Function secrets) or for running the
# backend locally with Node (cd server && npm run dev).

# Local Node only: Postgres connection (use the Supabase session pooler)
# DATABASE_URL="postgresql://postgres.emwmnghbxsoudfxxltna:[DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# JWT secrets — default: derived from the service role key
# JWT_SECRET=
# JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (only needed when the frontend calls the function cross-origin)
# CORS_ORIGIN=https://radiant-lucky-draw.vercel.app,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
