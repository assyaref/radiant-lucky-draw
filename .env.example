# ============================================================
# RADIANT LUCKY DRAW - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# ============================================================

# ─── Frontend (Vite) ────────────────────────────────────────

# App
VITE_APP_TITLE=Radiant Lucky Draw

# Public URL (used for QR registration link)
# Development: http://localhost:5173
# Production:  https://radiant-lucky-draw.vercel.app
VITE_PUBLIC_URL=http://localhost:5173


# API
# Development: http://localhost:3001 (or /api with the Vite proxy)
# Production:  https://radiant-lucky-draw.vercel.app/api  (routes through Vercel proxy)
VITE_API_BASE_URL=https://radiant-lucky-draw.vercel.app/api
VITE_API_TIMEOUT=30000

# Realtime (Socket.IO)
# Development: http://localhost:3001
# Production:  https://radiant-lucky-draw.vercel.app  (routes through Vercel proxy)
VITE_SOCKET_URL=https://radiant-lucky-draw.vercel.app


# Features
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEBUG=false

# ─── Backend (Express) ──────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# Database — Supabase Postgres (dev & production)
# Supabase Dashboard → Connect → ORMs → Prisma. Use a separate Supabase
# project for development and production.
#
# Runtime queries: Supavisor transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Prisma migrations: Supavisor session pooler (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# Optional — plain local Postgres via docker-compose (offline dev):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/radiant_lucky_draw?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/radiant_lucky_draw?schema=public"

# JWT (REQUIRED - no fallbacks; server will refuse to start without these)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d


# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=dev

# ─── Docker Compose (optional local Postgres) ───────────────

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=radiant_lucky_draw
